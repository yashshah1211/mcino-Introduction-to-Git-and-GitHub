Task 9 - github-branches
Repository: https://github.com/yashshah1211/mcino-Introduction-to-Git-and-GitHub

Reproducible Windows PowerShell command (queries live GitHub API):

$repo = "yashshah1211/mcino-Introduction-to-Git-and-GitHub"
$branches = curl.exe -sS "https://api.github.com/repos/$repo/branches?per_page=100" | ConvertFrom-Json
$branches | Sort-Object name | ForEach-Object {
    $branch = $_.name
    $status = if ($branch -eq "main") {
        "default"
    } else {
        $comparison = curl.exe -sS "https://api.github.com/repos/$repo/compare/main...$branch" | ConvertFrom-Json
        if ($comparison.ahead_by -eq 0) { "merged into main" } else { "not fully merged" }
    }
    [PSCustomObject]@{ Branch = $branch; Status = $status }
} | Format-Table -AutoSize

